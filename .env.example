# ═══════════════════════════════════════════════════════════════
# Contact form SMTP — used by app/api/contact/route.ts
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env.local and fill in your GoDaddy mailbox
# credentials. Never commit .env.local — it's gitignored.

# ── Option A: GoDaddy Workspace Email (the old product) ──
# If your mail panel says "Workspace Email" or you set it up before
# ~2021 and it doesn't use Microsoft 365, use these values:
#
# SMTP_HOST=smtpout.secureserver.net
# SMTP_PORT=465
# SMTP_USER=hello@victoriazeder.com
# SMTP_PASS=your-mailbox-password

# ── Option B: Microsoft 365 via GoDaddy (the newer product) ──
# If your email is Microsoft 365 (you log in at outlook.office.com),
# use these values. Port 587 with STARTTLS is required.
#
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=hello@victoriazeder.com
# SMTP_PASS=your-mailbox-password
#
# NOTE: Microsoft 365 often has "SMTP AUTH" disabled by default on
# new tenants. If sending fails with "535 5.7.139 Authentication
# unsuccessful", you need to enable SMTP AUTH for this mailbox:
#   1. Go to https://admin.microsoft.com → Users → Active Users
#   2. Click the hello@ mailbox → Mail tab → "Manage email apps"
#   3. Check "Authenticated SMTP" → Save
# Or have your admin enable it tenant-wide via PowerShell.

SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# (Optional) Where contact messages are delivered. Defaults to
# SMTP_USER if omitted. Leave blank unless you want a separate inbox.
CONTACT_TO_EMAIL=

# ═══════════════════════════════════════════════════════════════
# Upstash Redis — distributed rate limit (optional)
# ═══════════════════════════════════════════════════════════════
# When present, the contact API uses Upstash instead of its
# per-instance in-memory Map (3 req / 5 min / IP). Provision via
# the Vercel Marketplace — env vars are injected automatically:
#   vercel integration add upstash
# Or install from the dashboard: https://vercel.com/marketplace
#
# Falls back to in-memory rate limit silently when absent. Safe for
# local dev — you don't need these to run the contact form locally.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
